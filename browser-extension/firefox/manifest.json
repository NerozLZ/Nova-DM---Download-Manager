{
  "manifest_version": 2,
  "name": "Nova DM Integration",
  "version": "1.0.0",
  "description": "Sends downloads started in Firefox to Nova DM running on this computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nova-dm@novadm.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["downloads", "cookies", "storage", "http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Nova DM", "default_icon": "icon.svg" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
